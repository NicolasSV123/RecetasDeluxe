<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recipeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
<!--Frame para poder poder superponer el icono de favoritos sobre la imagen de la receta-->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="180dp">

                <ImageView
                    android:id="@+id/thumbnailImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_background"/>

                <ImageView
                    android:id="@+id/favoriteImageView"
                    android:layout_width="100dp"
                    android:layout_height="75dp"
                    android:layout_gravity="end"
                    android:padding="8dp"
                    android:src="@drawable/ic_favorite_added"
                    app:tint="@android:color/holo_blue_dark" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nameRecipeTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pizza"
                    android:textStyle="bold"
                    android:textSize="24sp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/countryChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🇪🇸  Country"
                        android:enabled="false"
                        app:ensureMinTouchTargetSize="false"/>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/timeChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="180 minutos ⏱️"
                        android:textSize="16sp"
                        android:enabled="false"
                        app:ensureMinTouchTargetSize="false"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal"
                    android:padding="2dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/difficultyChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Easy"
                        android:enabled="false"
                        app:ensureMinTouchTargetSize="false"/>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/caloriesChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="300 cal"
                        android:enabled="false"
                        app:ensureMinTouchTargetSize="false"/>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/servingsChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 👤"
                        android:enabled="false"
                        app:ensureMinTouchTargetSize="false"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>